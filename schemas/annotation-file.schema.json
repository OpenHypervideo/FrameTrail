                                        { "$ref": "common.schema.json#/$defs/phpEmptyObject" }
                                    ]
                                }
                            }
                        },
                        {
                            "type": "object",
                            "required": ["frametrail:type"],
                            "properties": {
                                "frametrail:type": {
                                    "description": "Legacy. No Resource type exists for \"button\"; FrameTrail does not render such items and keeps them unchanged.",
                                    "const": "button"
                                },
                                "frametrail:attributes": {
                                    "description": "Type-specific settings, see attributes/button.schema.json.",
                                    "oneOf": [
                                        { "$ref": "attributes/button.schema.json" },
                                        { "$ref": "common.schema.json#/$defs/phpEmptyObject" }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        }
    },
    "type": "array",
    "items": { "$ref": "#/$defs/annotation" }
}
