{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://frametrail.org/schemas/1/attributes/wikipedia.schema.json",
    "title": "frametrail:attributes of type \"wikipedia\"",
    "description": "Wikipedia article summary. The article URL is the src. This schema describes the frametrail:attributes of items (and the attributes of resources) whose type is \"wikipedia\". On overlays, opacity, hoverStyle, zIndex and animation apply as on every overlay type. Unknown keys are allowed; writers keep them.",
    "type": "object",
    "properties": {
        "articleUrl": {
            "description": "URL of the article.",
            "type": "string"
        },
        "wikiLang": {
            "description": "Language code of the Wikipedia edition, e.g. \"en\".",
            "type": "string"
        },
        "dir": {
            "description": "Text direction of the article.",
            "type": "string",
            "enum": ["ltr", "rtl"],
            "default": "ltr"
        },
        "description": {
            "description": "Short description of the article.",
            "type": "string"
        },
        "extract": {
            "description": "Summary, plain text.",
            "type": "string"
        },
        "extract_html": {
            "description": "Summary, HTML.",
            "type": "string"
        },
        "opacity": { "$ref": "../common.schema.json#/$defs/opacity" },
        "hoverStyle": { "$ref": "../common.schema.json#/$defs/hoverStyle" },
        "zIndex": { "$ref": "../common.schema.json#/$defs/zIndex" },
        "animation": { "$ref": "../common.schema.json#/$defs/animation" },
        "animationIn": { "$ref": "../common.schema.json#/$defs/animationIn" },
        "animationOut": { "$ref": "../common.schema.json#/$defs/animationOut" },
        "animationDuration": { "$ref": "../common.schema.json#/$defs/animationDuration" }
    }
}
